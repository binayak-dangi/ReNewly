{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "renewly-api",
    "Audience": "renewly-mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "EmailVerificationCodeMinutes": 1440,
    "PasswordResetCodeMinutes": 15,
    "MaxCodeAttempts": 5,
    "CodeResendCooldownSeconds": 60,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@renewly.app",
    "FromName": "Renewly",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseStartTls": true
    }
  },
  "Reminders": {
    "WorkerEnabled": true,
    "PollIntervalSeconds": 60,
    "BatchSize": 100,
    "MaxAttempts": 3,
    "RetryBaseDelayMinutes": 5,
    "StaleClaimMinutes": 10,
    "MaxLatenessHours": 24
  },
  "Firebase": {
    "CredentialsPath": "",
    "CredentialsJson": "",
    "ProjectId": "",
    "AndroidChannelId": "renewal_reminders"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
