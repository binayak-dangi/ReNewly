{
  "Email": {
    "Provider": "Log"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/renewly-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
      }
    ]
  }
}
