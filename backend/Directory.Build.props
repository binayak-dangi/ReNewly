<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage delegates are not worth the ceremony here.
         CA2007: ConfigureAwait is irrelevant in ASP.NET Core.
         CA1062: Nullable reference types already cover argument null checks.
         CA1716: 'Shared' namespace segment collides with a VB keyword; we do not target VB.
         CA1711/CA1515/CA1724: naming rules that conflict with Clean Architecture conventions. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1062;CA1716;CA1711;CA1515;CA1724;CA1812;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1002;CA2227;CA1819;CA1031;CA1056;CA1054;CA1055;CA1308;CA1034;CA1032;CA1064</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
